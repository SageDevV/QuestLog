{
  "name": "quest-log",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": "dist/launcher.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "build:launcher": "esbuild launcher.ts --bundle --platform=node --target=node18 --outfile=dist/launcher.js",
    "build:exe": "npm run build:launcher && npx pkg . --output dist/QuestLog.exe --icon assets/quest-log.ico && node scripts/copy-to-desktop.js",
    "deploy": "npm run build && npx firebase-tools deploy --only hosting"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "zustand": "^5.0.12"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist",
    "assets": [
      "dist/**/*",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@yao-pkg/pkg": "^6.14.2",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "fast-check": "^3.23.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
