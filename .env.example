# Telegram Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firebase Web App config (client-side, required by the web app to render/login)
# Firebase Console -> Project Settings -> General -> Your apps -> Web app -> SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Admin Service Account (server-side ONLY — never prefix with VITE_,
# never expose to the browser). Paste the service account JSON string here.
FIREBASE_SERVICE_ACCOUNT=
